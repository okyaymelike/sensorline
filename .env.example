# Copy to .env and adjust. Everything here is a LOCAL-DEV default and is only
# valid against the local docker-compose stack. Replace all credentials in any
# real deployment — the compose file reads these from the environment, so real
# secrets never need to live in a committed file.

# Postgres (compose reads these; also used to build DATABASE_URL below)
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry
POSTGRES_DB=telemetry
DATABASE_URL=postgresql://telemetry:telemetry@localhost:5434/telemetry

# Kafka
KAFKA_BOOTSTRAP=localhost:19092
KAFKA_TOPIC_READINGS=telemetry.readings

# Grafana admin (anonymous access is enabled for local use anyway)
GRAFANA_ADMIN_PASSWORD=telemetry

# Metrics ports the services expose (scraped by prometheus.yml)
INGESTER_METRICS_PORT=8001
SIMULATOR_METRICS_PORT=8002
PROCESSOR_METRICS_PORT=8003
