{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "title": "Sensorline",
  "uid": "sensorline",
  "tags": ["telemetry"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Temperature by device (°C)",
      "datasource": { "type": "postgres", "uid": "telemetrydb" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "telemetrydb" },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT r.sampled_at AS \"time\", d.external_id AS metric, r.value FROM reading r JOIN device d ON d.id = r.device_id WHERE r.metric = 'temperature_c' AND $__timeFilter(r.sampled_at) ORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total readings",
      "datasource": { "type": "postgres", "uid": "telemetrydb" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "telemetrydb" },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS value FROM reading"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Open anomalies",
      "datasource": { "type": "postgres", "uid": "telemetrydb" },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "telemetrydb" },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS value FROM anomaly WHERE resolved_at IS NULL"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Anomalies",
      "datasource": { "type": "postgres", "uid": "telemetrydb" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 9 },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "telemetrydb" },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT a.detected_at, a.type, a.severity, d.external_id AS device, a.detail::text AS detail FROM anomaly a JOIN device d ON d.id = a.device_id ORDER BY a.detected_at DESC"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ingest rate (live services only)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(ingester_readings_ingested_total[1m]))",
          "legendFormat": "ingested/s"
        }
      ]
    }
  ]
}
